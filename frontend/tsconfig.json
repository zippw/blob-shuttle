{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "strict": false,
        "paths": {
            "@shared/*": [
                "../src/shared/*"
            ],
            "@config/*": [
                "../src/config/*"
            ]
        }
    },
    "include": [
        "scripts/**/*.ts",
        "../src/config/**/*.ts",
        "../src/shared/**/*.ts"
    ]
}