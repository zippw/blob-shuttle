//- data-ui-group attr: control multiple elements (disable/enable all)
//- data-ui-id attr: control unique elements separately

doctype html
html(lang="en")
    -
        const api_url = consts.FUNCTION_URL;
        const assets_url = consts.HOST_SPA ? `${api_url}?path=static&file=` : `${consts.STATIC_URL}/`;


    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title BLOB-SHUTTLE

        link(rel="icon" type="image/png" href!=encodeURI(`${assets_url}icon-192x192.png`))
        link(rel="apple-touch-icon" href!=encodeURI(`${assets_url}icon-192x192.png`))

        -
            const manifest = {
                name: "blob-shuttle",
                short_name: "bs",
                display: "standalone",
                background_color: "#020303",
                theme_color: "#9b6cf0",
                orientation: "natural",
                start_url: consts.HOST_SPA ? api_url : '.',
                icons: [{
                    src: `${assets_url}icon-192x192.png`,
                    sizes: "192x192",
                    type: "image/png"
                }],
                share_target: {
                    action: encodeURI(`${assets_url}?path=share_target`),
                    method: "POST",
                    enctype: "multipart/form-data",
                    params: {
                        files: [{
                            name: "media",
                            accept: ["*/*"]
                        }]
                    }
                }
            }

        link(rel="manifest" href=`data:application/manifest+json,${encodeURIComponent(JSON.stringify(manifest))}`)

        link(href="https://cdn.jsdelivr.net/npm/@exuanbo/file-icons-js@latest/dist/css/file-icons.min.css" rel="stylesheet")
        style
            :css(path="frontend/styles/main.scss")

    body
        .modal__overlay#modals

        .main-wrapper

            main
                .form-wrapper.create-block
                    form#create
                        input#files_input.drop-zone__input(
                            data-ui-group="create-form"
                            accept
                            multiple type="file"
                            disabled=true
                            tabindex="-1"
                            data-max-file-count=consts.MAX_FILE_COUNT
                            data-max-file-size=consts.MAX_FILE_SIZE
                        )
                        label#files_dropzone.drop-zone(for="files_input")
                            h1 Drop files here, or click to choose
                            h2 Max file size: #{formatted.MAX_FILE_SIZE}. Maximum #{consts.MAX_FILE_COUNT} files.
                            small.error X
                        .upload-box
                            button#upload_files_btn.main(
                                data-ui-group="create-form"
                                data-ui-id="create-form-upload-btn"
                                disabled=true
                                tabindex="-1"
                                data-content-transition
                            )
                                span.content-old Upload
                                span.content-new.is-hidden

                .sep

                .form-wrapper.reveal-block
                    form#reveal
                        h1 Enter Vault ID
                        h2 to download files
                        .code-container#vault_id_pincodeinput
                            each v in new Array(6).fill(null)
                                input.code-input.main.error_animation(
                                    type="text" maxlength="1" autocomplete="off" value=v
                                    disabled=true tabindex="-1"
                                    data-ui-group="reveal-form-entrance"
                                )

                        small.error X

                    .file-container-wrapper
                        .file-container__nav
                            .side
                                button.main.main--sm#reveal_goback(data-ui-group="reveal-form-files")
                                    include ./icons/Chevron_Left.svg
                            .side.center
                                | ID:
                                .copy-input-wrapper#vaultid-copy-input-wrapper
                                    input.compact(name="vaultid-copy-input" type="text" readonly)
                                    button.compact(type="button" aria-label="Copy Vault ID")
                                        include ./icons/Copy.svg
                            .side.right
                                button.main.main--sm#share(data-ui-group="reveal-form-files")
                                    include ./icons/Share_Android.svg

                        .file-container#files_container.scrollable
                            .file-container__panel#files_container_panel
                                .group.group__search
                                    input.compact#files_search(
                                        type="text" placeholder="Search by filename..."
                                        data-ui-group="reveal-form-files"
                                        disabled=true tabindex="-1"
                                    )
                                .group.group__other
                                    select.compact#files_sortby(
                                        name="Sort by"
                                        data-ui-group="reveal-form-files"
                                        disabled=true tabindex="-1"
                                    ) 
                                        option(value="fn_asc") Filename (A-Z)
                                        option(value="fn_des") Filename (Z-A)
                                        option(value="fs_asc") Size (Asc)
                                        option(value="fs_des") Size (Desc)
                                    .radio.compact
                                        div.radio-input
                                            input#files_fl_rows(data-ui-group="reveal-form-files" name="files_layout" type="radio" disabled=true tabindex="-1")
                                            label(for="files_fl_rows")
                                                include ./icons/Text_Align_Justify.svg
                                        div.radio-input
                                            input#files_fl_table(data-ui-group="reveal-form-files" name="files_layout" type="radio" disabled=true tabindex="-1" checked)
                                            label(for="files_fl_table")
                                                include ./icons/Table.svg
                                        div.radio-input
                                            input#files_fl_grid(data-ui-group="reveal-form-files" name="files_layout" type="radio" disabled=true tabindex="-1")
                                            label(for="files_fl_grid")
                                                include ./icons/Grid.svg

                                    button.compact#files_download_all(data-content-transition data-ui-group="reveal-form-files" disabled=true tabindex="-1")
                                        span.content-old Download all
                                        span.content-new.is-hidden

                            .file-container__grid#files_container_grid.--table

                .form-wrapper.login-block
                    form#auth
                        h1 Enter Passcode
                        h2 to use this application
                        .input-grp
                            input#passcode.main.error_animation(data-ui-group="login-form" type="password" placeholder="Passcode")
                            button#passcode_btn.main(data-ui-group="login-form" type="submit" data-wavy) Enter
                        small.error X

            .background #[canvas#nebulaCanvas]


    script(type="module").
        import icons from 'https://cdn.jsdelivr.net/npm/@exuanbo/file-icons-js@latest/dist/js/file-icons.esm.min.js'
        window.getClass = icons.getClass;

    script.
        window.locals = {
            api_url: '!{api_url}',
            static_url: '!{assets_url}'
        }

    script
        :js(path="frontend/scripts/main.ts")
