{
    "name": "blob-shuttle",
    "short_name": "bs",
    "display": "standalone",
    "background_color": "#020303",
    "theme_color": "#9b6cf0",
    "orientation": "natural",
    "icons": [
        {
            "src": "https://service.zipp.pw/files?path=static&file=icon-192x192.png",
            "sizes": "192x192",
            "type": "image/png"
        }
    ],
    "share_target": {
        "action": "https://service.zipp.pw/files?path=share_target",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "files": [
                {
                    "name": "media",
                    "accept": [
                        "*/*"
                    ]
                }
            ]
        }
    }
}