# ============================================================
#  BLOB-SHUTTLE ENVIRONMENT VARIABLES
#  ============================================================
#  Copy this file to .env and fill in the values.
#  All keys are required unless marked (optional).
# ============================================================


# ------------- REQUIRED: BACKEND URL -------------

# Public URL of your function/backend (no trailing slash).
# This is where the frontend sends API requests.
FUNCTION_URL=https://example.com/path/to/my-function

# (optional) Override FUNCTION_URL when NODE_ENV='development'
DEV_FUNCTION_URL=http://localhost:8080/files


# ------------ REQUIRED: AUTHENTICATION ------------

# Master passcode - the main password to log in.
# Must be at least 1 character. Server caps at 1024 characters (see MAX_PASSCODE_LENGTH in constants.ts).
PASSCODE=my_cool-passcode1234

# Long-term passcode (optional but recommended).
# When entered, the client stores it in localStorage for auto-login.
# This is useful for trusted devices.
LONG_TERM_PASSCODE=my_cool_very_very_long_passcode



# ------------ REQUIRED: CRYPTOGRAPHIC KEYS ------------
# Must be exactly 64 hex characters (32 bytes).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Used to encrypt/decrypt invite tokens (aes-256-gcm)
ENCRYPTION_KEY=8a...7

# Used to generate and validate vault IDs (HMAC-SHA256)
VAULT_SECRET_KEY=88...b

# Used to verify passcode hashes (HMAC-SHA256)
HMAC_KEY=12...z



# ------------ OPTIONAL: LOCAL DEVELOPMENT ------------

# Port used by server.example.ts (default: 8080)
DEV_PORT=8080


# ------------ INFRASTRUCTURE-SPECIFIC (YANDEX CLOUD) ------------
# These are only needed if you use the yandex-cloud adapter.
# They come from custom middleware (src/infrastructure/yandex-cloud/middleware/).

# Yandex Document Database endpoint for RPM (requests per minute) counter
ydb_endpoint=https://docapi.serverless.yandexcloud.net/ru-central1/...

# Telegram bot token (for notifications when RPM limit is exceeded)
tg_tkn=...

# Telegram chat ID to send notifications to
tg_cid=...


# ------------ INFRASTRUCTURE-SPECIFIC (S3 STORAGE DRIVER) ------------
# These are used by src/infrastructure/drivers/storage/index.ts

STATIC_KEY_ID=...
STATIC_KEY_SECRET=...