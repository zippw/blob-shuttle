{
    "scripts": {
        "start": "node .",
        "build:clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
        "build:frontend": "gulp build",
        "build:backend": "tsc",
        "build:package": "node -e \"const pkg = require('./package.json'); delete pkg.devDependencies; delete pkg.scripts; fs.writeFileSync('dist/package.json', JSON.stringify(pkg, null, 2));\"",
        "build": "npm run build:clean && npm run build:frontend && npm run build:backend && npm run build:package",
        "watch:frontend": "gulp watch",
        "serve": ".\\serve.bat",
        "server": "node --env-file=.env --import tsx --watch server.ts"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/gulp": "^4.0.18",
        "@types/gulp-rename": "^2.0.7",
        "@types/gulp-sass": "^6.0.0",
        "@types/node": "^26.0.1",
        "@yandex-cloud/function-types": "^2.1.2",
        "esbuild": "^0.28.1",
        "express": "^5.2.1",
        "fast-glob": "^3.3.3",
        "gulp": "^5.0.1",
        "gulp-esbuild": "^0.15.0",
        "gulp-rename": "^2.1.0",
        "gulp-sass": "^6.0.1",
        "gulp-typescript": "^6.0.0-alpha.1",
        "ignore": "^7.0.5",
        "pug": "^3.0.4",
        "sass": "^1.101.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1075.0",
        "@aws-sdk/s3-request-presigner": "^3.1075.0",
        "pug-runtime": "^3.0.1"
    }
}
