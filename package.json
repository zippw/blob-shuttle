{
    "scripts": {
        "build:frontend": "node --import tsx build.ts --build",
        "build:backend": "tsc",
        "build": "npm run build:frontend && npm run build:backend",
        "serve": "cross-env NODE_ENV=development node --import tsx build.ts --watch",
        "server": "cross-env NODE_ENV=development tsx -r dotenv/config --watch server.example.ts"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.0.1",
        "@types/pug": "^2.0.10",
        "@yandex-cloud/function-types": "^2.1.2",
        "cross-env": "^10.1.0",
        "dotenv": "^17.4.2",
        "esbuild": "^0.28.1",
        "esbuild-plugin-tsconfig-paths": "^1.0.2",
        "express": "^5.2.1",
        "fast-glob": "^3.3.3",
        "ignore": "^7.0.5",
        "pug": "^3.0.4",
        "sass": "^1.101.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3"
    },
    "imports": {
        "#shared/*.js": "./src/shared/*.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1075.0",
        "@aws-sdk/s3-request-presigner": "^3.1075.0"
    }
}
